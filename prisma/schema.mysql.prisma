// prisma/schema.mysql.prisma (MySQL for Production Deployment with .env.prod)
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Transaction {
  id          String   @id @default(uuid())
  date        DateTime @default(now())
  type        String   // INCOME | EXPENSE
  amount      Float
  category    String
  note        String?  @db.Text
  source      String   @default("WEB") // WEB | CHATBOT | GOOGLE_SHEETS | SPLIT_BILL
  sheetRowId  Int?     // Row index in Google Sheet for 2-way sync
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SyncLog {
  id           String   @id @default(uuid())
  timestamp    DateTime @default(now())
  status       String   // SUCCESS | FAILED
  direction    String   // DB_TO_SHEET | SHEET_TO_DB
  affectedRows Int
  errorMessage String?  @db.Text
}

model Budget {
  id          String   @id @default(uuid())
  category    String   @unique
  limitAmount Float
  monthYear   String   @default("CURRENT") // e.g. 2026-08 or CURRENT
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Goal {
  id            String    @id @default(uuid())
  name          String
  targetAmount  Float
  currentAmount Float     @default(0)
  deadline      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model SplitBill {
  id             String   @id @default(uuid())
  title          String
  totalAmount    Float
  taxPercent     Float    @default(0)
  servicePercent Float    @default(0)
  paymentDetails String?  @db.Text
  participants   String   @db.Text // JSON formatted string [{ name, phone, amount, paid }]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ChatSession {
  id        String        @id @default(uuid())
  title     String        @default("Sesi Chat Baru")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]
}

model ChatMessage {
  id            String      @id @default(uuid())
  sessionId     String
  session       ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role          String      // "user" | "assistant"
  text          String      @db.Text
  image         String?     @db.LongText
  executedTools String?     @db.Text // JSON string of executed tools
  createdAt     DateTime    @default(now())
}

