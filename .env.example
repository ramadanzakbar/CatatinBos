# Catatin Application - Environment Variables Example

# Prisma & SQLite Local Database Configuration
DATABASE_URL="file:./dev.db"

# Google Agent Development Kit (Gemma 4 26B A4B IT Model API Key)
GEMMA_API_KEY="your_gemma_api_key_here"

# Google Sheets API Service Account Credentials (2-Way Sync)
GOOGLE_CLIENT_EMAIL="your-service-account@your-project-id.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
GOOGLE_SPREADSHEET_ID="your_google_spreadsheet_id_here"
