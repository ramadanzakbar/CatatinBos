# Catatin Application - Environment Variables Example (.env.example)

# Database Connection URL (SQLite for local development)
DATABASE_URL="file:./dev.db"

# MySQL Container Credentials (Used by Docker Compose)
MYSQL_ROOT_PASSWORD="rootpassword"
MYSQL_DATABASE="catatin_db"
MYSQL_USER="catatin_user"
MYSQL_PASSWORD="catatin_password"

# --- Vertex AI Model-as-a-Service (MaaS) Endpoint Configuration ---
ENDPOINT="aiplatform.googleapis.com"
REGION="global"
PROJECT_ID="YOUR_PROJECT_ID"
VERTEX_BEARER_TOKEN="" # e.g. token output from `gcloud auth print-access-token`
VERTEX_MODEL="google/gemma-4-26b-a4b-it-maas"

# --- Alternative Direct API Key (Vertex AI Express / Gemini API Key) ---
VERTEX_API_KEY=""
GEMMA_API_KEY=""
GEMINI_API_KEY=""

# Google Sheets API Service Account Credentials (2-Way Sync)
GOOGLE_CLIENT_EMAIL="your-service-account@your-project-id.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
GOOGLE_SPREADSHEET_ID="your_google_spreadsheet_id_here"
